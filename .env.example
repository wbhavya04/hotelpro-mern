# ============================================================================
# HOTELPRO — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `server/.env` (and `client/.env` for VITE_* variables)
# ============================================================================

# --- MANDATORY BACKEND VARIABLES ---
NODE_ENV=development
SERVER_PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro
JWT_SECRET=replace_with_a_strong_64_character_random_hex_secret_for_jwt_signing
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- OPTIONAL: EMAIL NOTIFICATIONS (NODEMAILER SMTP) ---
# If omitted in development, HotelPro logs formatted email payloads cleanly to stdout
# without failing booking or authentication workflows.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="HotelPro Reservations <reservations@hotelpro.in>"

# --- OPTIONAL: RAZORPAY PAYMENT GATEWAY (TEST / SANDBOX MODE) ---
# Provide your Razorpay Test Mode keys from https://dashboard.razorpay.com
# If omitted in development, HotelPro activates its explicitly labeled
# `razorpay_sandbox` simulator with full HMAC-SHA256 verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- FRONTEND (client/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api
